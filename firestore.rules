rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    // ── Coin history ────────────────────────────────────────────────────────
    // Server-only ledger. The client may read its own history but cannot mint entries.
    match /users/{userId}/coinHistory/{historyId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // ── Purchases ──────────────────────────────────────────────────────────
    match /users/{userId}/purchases/{purchaseId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // ── Presence ───────────────────────────────────────────────────────────
    match /presence/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // ── Private roles ──────────────────────────────────────────────────────
    // Role documents are trusted-server state. A player may read only their
    // own private role. The host must not be able to rewrite roles from the
    // client, because host browsers are untrusted.
    match /games/{gameId}/playerRoles/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Existing game rules remain below this point.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
