rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isHost(gameId) {
      return request.auth.uid == get(/databases/$(database)/documents/games/$(gameId)).data.hostUid;
    }

    function onlyUpdating(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function affectedAre(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function touchesServerControlledFields() {
      return affectedAre(['coins', 'dailyStreak', 'xp', 'gamesPlayed', 'gamesWon', 'consecutiveWins']);
    }

    function touchesSensitiveFields() {
      return affectedAre([
        'hostUid', 'code', 'roles', 'phase', 'status', 'winners', 'winMessage', 'wolfTeam',
        'eliminatedHistory', 'roundNumber', 'nightStartedAt', 'dayStartedAt', 'dayDuration', 'dayEliminatedUid',
        'currentEvent', 'eventRound', 'seerReveal', 'profetaReveal', 'saboteadorBan', 'forenseResults',
        'iluminadoReveal', 'noExileActive', 'eclipseActive', 'anonymousVotesActive', 'lovers', 'silencedPlayers',
        'enchanted', 'bearGrowl', 'lobosBlocked', 'brujaProtectedUid', 'hechiceraLifeUsed', 'hechiceraPoisonUsed',
        'vampiroBites', 'cultMembers', 'pescadorBoat', 'malditoUid', 'alborotadoraFight', 'alborotadoraUsed',
        'juezUsed', 'voteBanned', 'sirenaUid', 'sirenaLinked', 'cazadorPendingShot', 'chivoPendingChoice',
        'perroLoboChoices', 'salvajeMentors', 'virginiawoolFate', 'verdugos', 'cambiaformasTargets',
        'fantasmaPending', 'fantasmaUsed', 'doubleSeerActive', 'criaLoboRage', 'vigiaUsed', 'vigiaKnowsWolves',
        'angelResucitadorUsed', 'bansheePoints', 'alquimistaPotion', 'alquimistaRevealUid', 'hadaLinked',
        'principeUsed', 'espiaUsed', 'antiguoHit', 'brujaFoundVidente', 'guardianLastTarget', 'doctorLastTarget',
        'doctorSelfUsed'
      ]);
    }

    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'friends', 'friendRequests', 'xp', 'gamesPlayed', 'gamesWon', 'consecutiveWins'])
        && request.resource.data.uid == userId
        && request.resource.data.xp == 0
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.gamesWon == 0
        && request.resource.data.consecutiveWins == 0;
      allow update: if isAuth() && (
        (request.auth.uid == userId && !touchesServerControlledFields())
        || (
          onlyUpdating(['friendRequests'])
          && request.resource.data.friendRequests.hasAll(resource.data.friendRequests)
          && request.resource.data.friendRequests.size() <= resource.data.friendRequests.size() + 1
          && request.resource.data.friendRequests.hasAny([request.auth.uid])
        )
      );
    }

    match /users/{userId}/coinHistory/{historyId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /users/{userId}/purchases/{purchaseId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /presence/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    match /playerBehavior/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    match /gameInvites/{userId}/items/{inviteId} {
      allow read, delete: if isAuth() && request.auth.uid == userId;
      allow create: if isAuth();
    }

    match /games/{gameId} {
      allow read: if isAuth() || (resource.data.isPublic == true && resource.data.status == 'lobby');
      allow create: if isAuth() && request.auth.uid == request.resource.data.hostUid;
      allow update: if isAuth() && (
        request.auth.uid == resource.data.hostUid
        || (resource.data.status == 'lobby' && onlyUpdating(['players', 'playerCount']))
        || (
          resource.data.phase == 'night'
          && affectedAre(['nightActions', 'nightSubmissions'])
          && !touchesSensitiveFields()
          && !affectedAre(['dayVotes', 'players'])
        )
        || (
          (resource.data.phase == 'day' || resource.data.phase == 'voting')
          && affectedAre(['dayVotes'])
          && !touchesSensitiveFields()
          && !affectedAre(['nightActions', 'nightSubmissions', 'players'])
          && request.resource.data.dayVotes.diff(resource.data.dayVotes).affectedKeys().hasOnly([request.auth.uid])
        )
        || (
          request.auth.uid == resource.data.hostUid
          && onlyUpdating(['cursed', 'narratorBroadcast'])
          && (resource.data.phase == 'night' || resource.data.phase == 'day')
        )
        || (resource.data.phase == 'ended' && resource.data.players.exists(p, p.uid == request.auth.uid))
        || (
          onlyUpdating(['hostUid', 'players'])
          && request.resource.data.hostUid == request.auth.uid
          && resource.data.phase != 'lobby'
          && resource.data.players.exists(p, p.uid == request.auth.uid)
        )
        || (
          resource.data.phase == 'day'
          && onlyUpdating(['bansheePredictionUid'])
          && resource.data.players.exists(p, p.uid == request.auth.uid)
        )
        || (
          onlyUpdating(['fantasmaUsed', 'fantasmaPending'])
          && resource.data.players.exists(p, p.uid == request.auth.uid)
        )
      );
      allow delete: if isAuth() && request.auth.uid == resource.data.hostUid;
    }

    match /games/{gameId}/playerRoles/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isHost(gameId));
      allow write: if isAuth() && isHost(gameId);
    }

    match /games/{gameId}/reports/{reportId} {
      allow read: if isAuth() && isHost(gameId);
      allow create: if isAuth();
      allow update, delete: if false;
    }

    match /games/{gameId}/nightLogs/{round} {
      allow read: if isAuth();
      allow write: if isAuth() && isHost(gameId);
    }

    match /games/{gameId}/votes/{voterUid} {
      allow read: if isAuth();
      allow create, update: if isAuth()
        && request.auth.uid == voterUid
        && (get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'day' || get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'voting')
        && request.resource.data.keys().hasOnly(['target', 'round', 'submittedAt']);
      allow write: if isAuth() && isHost(gameId);
      allow delete: if false;
    }

    match /games/{gameId}/lobbyChat/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if false;
    }

    match /games/{gameId}/publicChat/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth() && (request.auth.uid == request.resource.data.senderId || isHost(gameId));
      allow update, delete: if false;
    }

    match /games/{gameId}/ghostChat/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHost(gameId) || (request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid && p.isAlive == false)));
      allow update, delete: if false;
    }

    match /games/{gameId}/wolfChat/{messageId} {
      allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.wolfTeam[request.auth.uid] == true || (get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Espía' && get(/databases/$(database)/documents/games/$(gameId)).data.espiaUsed == true));
      allow create: if isAuth() && (isHost(gameId) || (request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.wolfTeam[request.auth.uid] == true));
      allow update, delete: if false;
    }

    match /games/{gameId}/loversChat/{messageId} {
      allow read: if isAuth() && (isHost(gameId) || (get(/databases/$(database)/documents/games/$(gameId)).data.lovers != null && (get(/databases/$(database)/documents/games/$(gameId)).data.lovers[0] == request.auth.uid || get(/databases/$(database)/documents/games/$(gameId)).data.lovers[1] == request.auth.uid)));
      allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.lovers != null && (get(/databases/$(database)/documents/games/$(gameId)).data.lovers[0] == request.auth.uid || get(/databases/$(database)/documents/games/$(gameId)).data.lovers[1] == request.auth.uid);
      allow update, delete: if false;
    }

    match /games/{gameId}/twinChat/{messageId} {
      allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid));
      allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /games/{gameId}/fairyChat/{messageId} {
      allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid));
      allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /games/{gameId}/hermanosChat/{messageId} {
      allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Hermanos');
      allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Hermanos';
      allow update, delete: if false;
    }

    match /games/{gameId}/nightActions/{actionId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (isHost(gameId) || request.auth.uid == actionId);
      allow delete: if false;
    }

    match /games/{gameId}/voicePresence/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == uid;
    }

    match /games/{gameId}/voiceOffers/{offerId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth();
      allow update: if false;
    }

    match /games/{gameId}/voiceAnswers/{answerId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth();
      allow update: if false;
    }

    match /games/{gameId}/voiceIce/{pairId}/candidates/{candidateId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if false;
      allow update: if false;
    }
  }
}