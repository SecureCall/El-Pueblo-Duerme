rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isHost(gameId) { return request.auth.uid == get(/databases/$(database)/documents/games/$(gameId)).data.hostUid; }
    function onlyUpdating(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function affectedAre(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function touchesSensitiveFields() { return request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostUid','code','roles','phase','status','winners','winMessage','wolfTeam','eliminatedHistory','roundNumber','nightStartedAt','dayStartedAt','dayDuration','dayEliminatedUid','currentEvent','eventRound','seerReveal','profetaReveal','saboteadorBan','forenseResults','iluminadoReveal','noExileActive','eclipseActive','anonymousVotesActive','lovers','silencedPlayers','enchanted','bearGrowl','lobosBlocked','brujaProtectedUid','hechiceraLifeUsed','hechiceraPoisonUsed','vampiroBites','cultMembers','pescadorBoat','malditoUid','alborotadoraFight','alborotadoraUsed','juezUsed','voteBanned','sirenaUid','sirenaLinked','cazadorPendingShot','chivoPendingChoice','perroLoboChoices','salvajeMentors','virginiawoolFate','verdugos','cambiaformasTargets','fantasmaPending','fantasmaUsed','doubleSeerActive','criaLoboRage','vigiaUsed','vigiaKnowsWolves','angelResucitadorUsed','bansheePoints','alquimistaPotion','alquimistaRevealUid','hadaLinked','principeUsed','espiaUsed','antiguoHit','brujaFoundVidente','guardianLastTarget','doctorLastTarget','doctorSelfUsed','lastWordsUsed']); }
    function touchesProgressionFields() { return request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp','gamesPlayed','gamesWon','consecutiveWins']); }
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && ((request.auth.uid == userId && !touchesProgressionFields() && !affectedAre(['coins'])) || onlyUpdating(['friendRequests']));
    }
    match /users/{userId}/coinHistory/{historyId} { allow read: if isAuth() && request.auth.uid == userId; allow create, update, delete: if false; }
    match /users/{userId}/purchases/{purchaseId} { allow read: if isAuth() && request.auth.uid == userId; allow create, update, delete: if false; }
    match /presence/{userId} { allow read: if isAuth(); allow write: if isAuth() && request.auth.uid == userId; }
    match /playerBehavior/{userId} { allow read, create, update, delete: if isAuth() && request.auth.uid == userId; }
    match /gameInvites/{userId}/items/{inviteId} { allow read, delete: if isAuth() && request.auth.uid == userId; allow create: if isAuth(); }
    match /games/{gameId} {
      allow read: if isAuth() && (resource.data.status == 'lobby' || resource.data.hostUid == request.auth.uid || resource.data.players.exists(p, p.uid == request.auth.uid));
      allow create: if isAuth() && request.auth.uid == request.resource.data.hostUid;
      allow update: if isAuth() && (
        (request.auth.uid == resource.data.hostUid && request.resource.data.roles == resource.data.roles) ||
        (resource.data.status == 'lobby' && onlyUpdating(['players','playerCount']) && request.resource.data.players.size() == resource.data.players.size() + 1 && !resource.data.players.exists(p, p.uid == request.auth.uid) && request.resource.data.players.exists(p, p.uid == request.auth.uid) && request.resource.data.playerCount == request.resource.data.players.size()) ||
        (resource.data.phase == 'night' && affectedAre(['nightActions','nightSubmissions']) && !touchesSensitiveFields() && !affectedAre(['dayVotes','players']) ) ||
        ((resource.data.phase == 'day' || resource.data.phase == 'voting') && affectedAre(['dayVotes']) && !touchesSensitiveFields() && !affectedAre(['nightActions','nightSubmissions','players']) && request.resource.data.dayVotes.diff(resource.data.dayVotes).affectedKeys().hasOnly([request.auth.uid])) ||
        (request.auth.uid == resource.data.hostUid && onlyUpdating(['cursed','narratorBroadcast']) && (resource.data.phase == 'night' || resource.data.phase == 'day')) ||
        (resource.data.phase == 'ended' && resource.data.players.exists(p, p.uid == request.auth.uid)) ||
        (onlyUpdating(['hostUid','players']) && request.resource.data.hostUid == request.auth.uid && resource.data.phase != 'lobby' && resource.data.players.exists(p, p.uid == request.auth.uid) && request.auth.uid != resource.data.hostUid && (!exists(/databases/$(database)/documents/presence/$(resource.data.hostUid)) || get(/databases/$(database)/documents/presence/$(resource.data.hostUid)).data.lastSeen < request.time.seconds * 1000 - 300000)) ||
        (onlyUpdating(['fantasmaUsed','fantasmaPending']) && resource.data.players.exists(p, p.uid == request.auth.uid))
      );
      allow delete: if isAuth() && request.auth.uid == resource.data.hostUid;
    }
    match /games/{gameId}/playerRoles/{uid} { allow read: if isAuth() && (request.auth.uid == uid || isHost(gameId)); allow create: if isAuth() && isHost(gameId) && get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'lobby' && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == uid) && request.resource.data.role == get(/databases/$(database)/documents/games/$(gameId)).data.roles[uid]; allow update, delete: if false; }
    match /games/{gameId}/reports/{reportId} { allow read: if isAuth() && isHost(gameId); allow create: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow update, delete: if false; }
    match /games/{gameId}/nightLogs/{round} { allow read: if isAuth() && isHost(gameId); allow write: if isAuth() && isHost(gameId); }
    match /games/{gameId}/votes/{voterUid} { allow read: if isAuth() && isHost(gameId); allow create, update, delete: if false; }
    match /games/{gameId}/lobbyChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid)); allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid)); allow update, delete: if false; }
    match /games/{gameId}/publicChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid)); allow create: if isAuth() && request.resource.data.keys().hasOnly(['senderId','senderName','text','type','createdAt']) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280 && request.resource.data.type != 'lastWords' && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid) && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'day' || get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'voting'); allow update, delete: if false; }
    match /games/{gameId}/ghostChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Médium' || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid && p.isAlive == false)); allow create: if isAuth() && (isHost(gameId) || (request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid && p.isAlive == false))); allow update, delete: if false; }
    match /games/{gameId}/wolfChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.wolfTeam[request.auth.uid] == true || (get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Espía' && get(/databases/$(database)/documents/games/$(gameId)).data.espiaUsed == true)); allow create: if isAuth() && (isHost(gameId) || (request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.wolfTeam[request.auth.uid] == true)); allow update, delete: if false; }
    match /games/{gameId}/loversChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || (get(/databases/$(database)/documents/games/$(gameId)).data.lovers != null && (get(/databases/$(database)/documents/games/$(gameId)).data.lovers[0] == request.auth.uid || get(/databases/$(database)/documents/games/$(gameId)).data.lovers[1] == request.auth.uid))); allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.lovers != null && (get(/databases/$(database)/documents/games/$(gameId)).data.lovers[0] == request.auth.uid || get(/databases/$(database)/documents/games/$(gameId)).data.lovers[1] == request.auth.uid); allow update, delete: if false; }
    match /games/{gameId}/twinChat/{messageId} { allow read, create: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Gemela' || get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Gemelas'); allow update, delete: if false; }
    match /games/{gameId}/fairyChat/{messageId} { allow read, create: if isAuth() && (isHost(gameId) || (get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Hada Buscadora' && get(/databases/$(database)/documents/games/$(gameId)).data.hadaLinked == true)); allow update, delete: if false; }
    match /games/{gameId}/hermanosChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Hermanos'); allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && get(/databases/$(database)/documents/games/$(gameId)).data.roles[request.auth.uid] == 'Hermanos'; allow update, delete: if false; }
    match /games/{gameId}/nightActions/{actionId} { allow read: if isAuth(); allow create, update, delete: if false; }
    match /games/{gameId}/voicePresence/{uid} { allow read: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow write: if isAuth() && request.auth.uid == uid && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); }
    match /games/{gameId}/voiceOffers/{offerId} { allow read, create, delete: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow update: if false; }
    match /games/{gameId}/voiceAnswers/{answerId} { allow read, create, delete: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow update: if false; }
    match /games/{gameId}/voiceIce/{pairId}/candidates/{candidateId} { allow read, create: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow delete, update: if false; }
  }
}
