rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isHost(gameId) { return request.auth.uid == get(/databases/$(database)/documents/games/$(gameId)).data.hostUid; }
    function privateRole(gameId, uid) { return get(/databases/$(database)/documents/games/$(gameId)/playerRoles/$(uid)).data.role; }
    function onlyUpdating(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function affectedAre(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function touchesSensitiveFields() { return request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostUid','code','roles','phase','status','winners','winMessage','wolfTeam','eliminatedHistory','roundNumber','nightStartedAt','dayStartedAt','dayDuration','dayEliminatedUid','phaseEndsAt','currentEvent','eventRound','seerReveal','profetaReveal','saboteadorBan','forenseResults','iluminadoReveal','noExileActive','eclipseActive','anonymousVotesActive','lovers','silencedPlayers','enchanted','bearGrowl','lobosBlocked','brujaProtectedUid','hechiceraLifeUsed','hechiceraPoisonUsed','vampiroBites','cultMembers','pescadorBoat','malditoUid','alborotadoraFight','alborotadoraUsed','juezUsed','voteBanned','sirenaUid','sirenaLinked','cazadorPendingShot','chivoPendingChoice','perroLoboChoices','salvajeMentors','virginiawoolFate','verdugos','cambiaformasTargets','fantasmaPending','fantasmaUsed','doubleSeerActive','criaLoboRage','vigiaUsed','vigiaKnowsWolves','angelResucitadorUsed','bansheePoints','alquimistaPotion','alquimistaRevealUid','hadaLinked','principeUsed','espiaUsed','antiguoHit','brujaFoundVidente','guardianLastTarget','doctorLastTarget','doctorSelfUsed','lastWordsUsed','nightActions','nightSubmissions','confessionUid','confessionEndsAt']); }
    function touchesProgressionFields() { return request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp','gamesPlayed','gamesWon','consecutiveWins']); }
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['uid','displayName','email','photoURL','coins','createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 3 &&
        request.resource.data.displayName.size() <= 60 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 320 &&
        request.resource.data.photoURL is string &&
        request.resource.data.photoURL.size() <= 2048 &&
        request.resource.data.coins == 100;
      allow update: if isAuth() && request.auth.uid == userId &&
        (onlyUpdating(['displayName','photoURL']) || onlyUpdating(['friendRequests']));
    }
    match /users/{userId}/coinHistory/{historyId} { allow read: if isAuth() && request.auth.uid == userId; allow create, update, delete: if false; }
    match /users/{userId}/purchases/{purchaseId} { allow read: if isAuth() && request.auth.uid == userId; allow create, update, delete: if false; }
    match /presence/{userId} { allow read: if isAuth(); allow write: if isAuth() && request.auth.uid == userId; }
    match /playerBehavior/{userId} { allow read: if isAuth() && request.auth.uid == userId; allow create, update, delete: if false; }
    match /gameInvites/{userId}/items/{inviteId} { allow read, delete: if isAuth() && request.auth.uid == userId; allow create: if isAuth(); }
    match /games/{gameId} {
      allow read: if isAuth() && (resource.data.status == 'lobby' || resource.data.hostUid == request.auth.uid || resource.data.players.exists(p, p.uid == request.auth.uid));
      allow create: if isAuth() && request.auth.uid == request.resource.data.hostUid;
      allow update: if isAuth() && (
        (resource.data.status == 'lobby' && onlyUpdating(['players','playerCount']) && request.resource.data.players.size() == resource.data.players.size() + 1 && !resource.data.players.exists(p, p.uid == request.auth.uid) && request.resource.data.players.exists(p, p.uid == request.auth.uid) && request.resource.data.playerCount == request.resource.data.players.size()) ||
        (request.auth.uid == resource.data.hostUid && onlyUpdating(['cursed','narratorBroadcast']) && (resource.data.phase == 'night' || resource.data.phase == 'day')) ||
        (onlyUpdating(['hostUid','players']) && request.resource.data.hostUid == request.auth.uid && resource.data.phase != 'lobby' && resource.data.players.exists(p, p.uid == request.auth.uid) && request.auth.uid != resource.data.hostUid && (!exists(/databases/$(database)/documents/presence/$(resource.data.hostUid)) || get(/databases/$(database)/documents/presence/$(resource.data.hostUid)).data.lastSeen < request.time.seconds * 1000 - 300000)) ||
        (onlyUpdating(['fantasmaUsed','fantasmaPending']) && resource.data.players.exists(p, p.uid == request.auth.uid))
      );
      allow delete: if isAuth() && request.auth.uid == resource.data.hostUid;
    }
    match /games/{gameId}/playerRoles/{uid} { allow read: if isAuth() && (request.auth.uid == uid || isHost(gameId)); allow create, update, delete: if false; }
    match /games/{gameId}/reports/{reportId} { allow read: if isAuth() && isHost(gameId); allow create: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow update, delete: if false; }
    match /games/{gameId}/nightLogs/{round} { allow read: if isAuth() && isHost(gameId); allow write: if isAuth() && isHost(gameId); }
    match /games/{gameId}/votes/{voterUid} { allow read: if isAuth() && isHost(gameId); allow create, update, delete: if false; }
    match /games/{gameId}/lobbyChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid)); allow create: if isAuth() && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']) && request.auth.uid == request.resource.data.senderId && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280 && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid)); allow update: if false; allow delete: if isAuth() && (isHost(gameId) || (resource.data.senderId == request.auth.uid && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid))); }
    match /games/{gameId}/publicChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid)); allow create: if isAuth() && request.resource.data.keys().hasOnly(['senderId','senderName','text','type','createdAt']) && request.resource.data.senderId == request.auth.uid && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280 && request.resource.data.type != 'lastWords' && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid) && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'day' || get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'voting') && (!get(/databases/$(database)/documents/games/$(gameId)).data.keys().hasAll(['currentEvent']) || get(/databases/$(database)/documents/games/$(gameId)).data.currentEvent.mechanical != 'forceConfession' || (get(/databases/$(database)/documents/games/$(gameId)).data.keys().hasAll(['confessionUid','confessionEndsAt']) && (get(/databases/$(database)/documents/games/$(gameId)).data.confessionUid == request.auth.uid || request.time >= get(/databases/$(database)/documents/games/$(gameId)).data.confessionEndsAt))); allow update, delete: if false; }
    match /games/{gameId}/ghostChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || privateRole(gameId, request.auth.uid) == 'Médium' || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid && p.isAlive == false)); allow create: if isAuth() && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']) && request.auth.uid == request.resource.data.senderId && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 && (isHost(gameId) || get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid && p.isAlive == false)); allow update, delete: if false; }
    match /games/{gameId}/wolfChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || (get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid && p.isAlive == true) && (privateRole(gameId, request.auth.uid) in ['Lobo', 'Lobo Blanco', 'Cría de Lobo'] || (privateRole(gameId, request.auth.uid) == 'Espía' && get(/databases/$(database)/documents/games/$(gameId)).data.espiaUsed == true)))); allow create: if isAuth() && request.resource.data.keys().hasOnly(['senderId','senderName','name','text','createdAt']) && request.auth.uid == request.resource.data.senderId && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 && get(/databases/$(database)/documents/games/$(gameId)).data.phase == 'night' && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid && p.isAlive == true && p.isAI != true) && privateRole(gameId, request.auth.uid) in ['Lobo', 'Lobo Blanco', 'Cría de Lobo']; allow update, delete: if false; }
    match /games/{gameId}/loversChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || (get(/databases/$(database)/documents/games/$(gameId)).data.lovers != null && (get(/databases/$(database)/documents/games/$(gameId)).data.lovers[0] == request.auth.uid || get(/databases/$(database)/documents/games/$(gameId)).data.lovers[1] == request.auth.uid))); allow create: if isAuth() && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']) && request.auth.uid == request.resource.data.senderId && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 && get(/databases/$(database)/documents/games/$(gameId)).data.lovers != null && (get(/databases/$(database)/documents/games/$(gameId)).data.lovers[0] == request.auth.uid || get(/databases/$(database)/documents/games/$(gameId)).data.lovers[1] == request.auth.uid); allow update, delete: if false; }
    match /games/{gameId}/twinChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || privateRole(gameId, request.auth.uid) in ['Gemela', 'Gemelas']); allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']) && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 && privateRole(gameId, request.auth.uid) in ['Gemela', 'Gemelas']; allow update, delete: if false; }
    match /games/{gameId}/fairyChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || (privateRole(gameId, request.auth.uid) == 'Hada Buscadora' && get(/databases/$(database)/documents/games/$(gameId)).data.hadaLinked == true)); allow create: if isAuth() && request.auth.uid == request.resource.data.senderId && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']) && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 && privateRole(gameId, request.auth.uid) == 'Hada Buscadora' && get(/databases/$(database)/documents/games/$(gameId)).data.hadaLinked == true; allow update, delete: if false; }
    match /games/{gameId}/hermanosChat/{messageId} { allow read: if isAuth() && (isHost(gameId) || privateRole(gameId, request.auth.uid) == 'Hermanos'); allow create: if isAuth() && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']) && request.auth.uid == request.resource.data.senderId && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 60 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 && privateRole(gameId, request.auth.uid) == 'Hermanos'; allow update, delete: if false; }
    match /games/{gameId}/nightActions/{actionId} { allow read, create, update, delete: if false; }
    match /games/{gameId}/nightSubmissions/{submissionId} { allow read, create, update, delete: if false; }
    match /games/{gameId}/voicePresence/{uid} { allow read: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow write: if isAuth() && request.auth.uid == uid && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); }
    match /games/{gameId}/voiceOffers/{offerId} { allow read, create, delete: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow update: if false; }
    match /games/{gameId}/voiceAnswers/{answerId} { allow read, create, delete: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow update, delete: if false; }
    match /games/{gameId}/voiceIce/{pairId}/candidates/{candidateId} { allow read, create: if isAuth() && get(/databases/$(database)/documents/games/$(gameId)).data.players.exists(p, p.uid == request.auth.uid); allow delete, update: if false; }
  }
}
